import logging
import asyncio
from telegram import Update
from telegram.constants import ChatMemberStatus
from telegram.ext import Application, MessageHandler, filters, ContextTypes

# Enable logging
logging.basicConfig(
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s', level=logging.INFO
)
logger = logging.getLogger(__name__)

# Replace 'YOUR_BOT_TOKEN' with your actual bot token from @BotFather
TOKEN = 'YOUR_BOT_TOKEN'

async def wait_and_delete(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Waits 50 seconds and deletes the message if the sender is not the owner."""
    
    # Ensure there is a message to check
    if not update.effective_message or not update.effective_chat:
        return

    chat_id = update.effective_chat.id
    message_id = update.effective_message.message_id
    
    # In Channels, the 'from_user' might be None because posts are made by the channel.
    # If a user is posting (e.g., linked discussion groups or admin accounts), we grab their ID.
    if update.effective_user:
        user_id = update.effective_user.id
        try:
            # Check the status of the user who posted
            member = await context.bot.get_chat_member(chat_id=chat_id, user_id=user_id)
            
            # If the user is the Owner (Creator), do nothing and let the post stay
            if member.status == ChatMemberStatus.OWNER:
                logger.info(f"Message {message_id} left untouched: Sent by Owner.")
                return
        except Exception as e:
            logger.error(f"Could not verify user status: {e}")

    # If it's not the owner, start the 50-second countdown
    logger.info(f"Non-owner message detected ({message_id}). Waiting 50 seconds to delete...")
    
    # Non-blocking sleep for 50 seconds
    await asyncio.sleep(50)

    try:
        # Delete the message after the wait time has passed
        await context.bot.delete_message(chat_id=chat_id, message_id=message_id)
        logger.info(f"Successfully deleted message {message_id} after 50 seconds.")
    except Exception as e:
        logger.error(f"Failed to delete message {message_id}: {e}")

def main() -> None:
    """Start the bot."""
    application = Application.builder().token(TOKEN).build()

    # The filter handles posts in both Channels and Channel-linked discussion Groups
    channel_post_filter = filters.ChatType.CHANNEL | filters.ChatType.GROUPS
    
    # Monitor all types of messages (text, photo, links, video, etc.)
    application.add_handler(MessageHandler(filters.ALL & channel_post_filter, wait_and_delete))

    # Run the bot
    application.run_polling(allowed_updates=Update.ALL_TYPES)

if __name__ == '__main__':
    main()
